{%- comment -%}
  Renders an editor-picked image, or a bundled avm-* asset as fallback,
  always with explicit width/height.

  Accepts:
  - image: image_picker value (optional)
  - asset: bundled asset filename used when image is blank (optional)
  - alt: alt text (falls back to image.alt)
  - class: class for the <img>
  - sizes: sizes attribute (default 100vw)
  - widths: srcset widths for picked images (default '375, 550, 750, 1100, 1500, 2200')
  - loading: 'lazy' (default) or 'eager'
  - fetchpriority: optional, e.g. 'high'

  Usage:
  {% render 'avm-image', image: block.settings.image, asset: block.settings.asset, alt: block.settings.alt, class: 'x' %}
{%- endcomment -%}
{%- liquid
  assign img_alt = alt | default: image.alt | default: ''
  assign img_sizes = sizes | default: '100vw'
  assign img_widths = widths | default: '375, 550, 750, 1100, 1500, 2200'
  assign img_loading = loading | default: 'lazy'
-%}
{%- if image != blank -%}
  {%- if fetchpriority != blank -%}
    {{
      image
      | image_url: width: 2200
      | image_tag:
        widths: img_widths,
        sizes: img_sizes,
        width: image.width,
        height: image.height,
        loading: img_loading,
        fetchpriority: fetchpriority,
        alt: img_alt,
        class: class
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 2200
      | image_tag:
        widths: img_widths,
        sizes: img_sizes,
        width: image.width,
        height: image.height,
        loading: img_loading,
        alt: img_alt,
        class: class
    }}
  {%- endif -%}
{%- elsif asset != blank -%}
  {%- capture size -%}{% render 'avm-asset-size', asset: asset %}{%- endcapture -%}
  {%- assign size = size | strip | split: ' ' -%}
  <img
    src="{{ asset | asset_url }}"
    alt="{{ img_alt | escape }}"
    width="{{ size[0] }}"
    height="{{ size[1] }}"
    loading="{{ img_loading }}"
    {% if fetchpriority != blank %}
      fetchpriority="{{ fetchpriority }}"
    {% endif %}
    class="{{ class }}"
  >
{%- endif -%}
