{%- comment -%}
  AVM careers form — mirrors the #apply section of careers/page.tsx + CareersForm.tsx.

  What the Next.js /api/careers route expects (multipart/form-data, because of the CV):
    name*, email*, phone, city, areaOfInterest*, introduction, cv (file, ≤ 5 MB, .pdf/.doc/.docx),
    company_website (honeypot, empty), form_started_at (ms timestamp)
  Responds { success: true } on success, { success: false, error } on failure.
{%- endcomment -%}

{{ 'avm-forms.css' | asset_url | stylesheet_tag }}
<script src="{{ 'avm-forms.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign phone_tel = s.help_phone | remove: ' '
-%}

<div class="avm avm-form-section avm-form-section--careers avm-form-section__anchor" id="{{ s.anchor | default: 'apply' | handleize }}">
  <div class="avm-form-section__inner">
    <div class="avm-form-section__header" data-avm-reveal>
      {%- if s.heading != blank -%}
        <h2 class="avm-form-section__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="avm-form-section__text">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>

    <div data-avm-reveal style="--avm-reveal-delay: 0.1s;">
      <avm-form-handler
        data-action="{{ s.form_action | escape }}"
        data-encoding="multipart"
        data-ok-key="success"
        data-success="replace"
        data-error-message="{{ s.error_message | escape }}"
      >
        <form class="avm-form" method="post" enctype="multipart/form-data" aria-busy="false">
          {%- render 'avm-form-spam-guard', prefix: 'c' -%}
          {%- render 'avm-form-notice', action: s.form_action -%}

          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'c-name', name: 'name', label: 'Name', is_required: true -%}
            {%- render 'avm-form-field', id: 'c-email', name: 'email', label: 'Email', type: 'email', is_required: true -%}
          </div>
          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'c-phone', name: 'phone', label: 'Phone', type: 'tel' -%}
            {%- render 'avm-form-field', id: 'c-city', name: 'city', label: 'City' -%}
          </div>
          {%- render 'avm-form-field',
            id: 'c-area',
            name: 'areaOfInterest',
            label: 'Area of interest',
            type: 'select',
            is_required: true,
            options: s.areas,
            select_placeholder: 'Select an area'
          -%}
          {%- render 'avm-form-field',
            id: 'c-intro',
            name: 'introduction',
            label: 'Brief introduction',
            type: 'textarea',
            rows: 5,
            placeholder: "Tell us about your background and why you'd like to work with AVM Healthcare"
          -%}

          <div>
            <span id="c-cv-label" class="avm-form-label">Attach your CV (PDF or Word)</span>
            <input
              id="c-cv"
              name="cv"
              type="file"
              accept=".pdf,.doc,.docx"
              aria-labelledby="c-cv-label"
              class="avm-form-file"
              data-avm-file
              data-max-bytes="5242880"
              data-too-large-message="Your CV is over 5MB. Please attach a smaller file or email it directly."
            >
            <label for="c-cv" class="avm-form-input avm-form-file-label">
              <span class="avm-form-file-name" data-avm-file-name="c-cv" data-placeholder="Choose file…">Choose file…</span>
              <span class="avm-form-file-browse">Browse</span>
            </label>
            <p class="avm-form-help">
              Maximum file size 5MB. If upload fails, please email your CV directly to
              <a href="mailto:{{ s.help_email }}">{{ s.help_email | escape }}</a>
              or call
              <a href="tel:{{ phone_tel }}">{{ s.help_phone | escape }}</a>.
            </p>
          </div>

          <div class="avm-form-alert avm-form-alert--error" role="alert" data-avm-form-error hidden></div>

          <button type="submit" class="avm-form-submit">Submit expression of interest</button>
        </form>
        {%- render 'avm-form-success', message: s.success_message -%}
      </avm-form-handler>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AVM careers form",
  "tag": "section",
  "class": "avm-careers-form-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "The hero button links here, e.g. #apply.", "default": "apply" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Express Your Interest" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us a bit about yourself and what you’d like to bring to AVM. We’ll keep your profile on file and reach out when a suitable opportunity opens up."
    },
    {
      "type": "textarea",
      "id": "areas",
      "label": "Areas of interest",
      "info": "One per line.",
      "default": "Sales & Business Development\nOperations & Logistics\nProduct Management\nMedical Affairs\nFinance & Administration\nOther"
    },
    { "type": "text", "id": "help_email", "label": "CV fallback email", "default": "careers@avmhealthcare.com" },
    { "type": "text", "id": "help_phone", "label": "CV fallback phone", "default": "+91 98100 74695" },
    {
      "type": "header",
      "content": "Submission"
    },
    {
      "type": "text",
      "id": "form_action",
      "label": "Form action URL",
      "info": "Endpoint that receives multipart/form-data (name, email, phone, city, areaOfInterest, introduction, cv, company_website, form_started_at) and replies { success: true }. Must allow cross-origin requests from this store."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "We've received your application. We'll be in touch soon."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Something went wrong. Please try again or email us directly at sales@avmhealthcare.com."
    }
  ],
  "presets": [{ "name": "AVM careers form" }]
}
{% endschema %}
