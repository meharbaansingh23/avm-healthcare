{%- comment -%}
  AVM blog preview — mirrors HomeContent.tsx section 8.
  Shows the latest articles of the chosen blog. Until that blog has articles,
  the three posts from the live site are shown (linking to /blogs/blog/<slug>).
  Category = the article's first tag.
{%- endcomment -%}

{{ 'avm-blog-preview.css' | asset_url | stylesheet_tag }}
{{ 'avm-article-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = section.settings.blog
  assign view_all_link = section.settings.view_all_link | default: blog.url | default: '/blogs/blog'
-%}

<div class="avm avm-blog-preview">
  <div class="avm-blog-preview__inner">
    <div class="avm-section-header" data-avm-reveal>
      {%- if section.settings.label != blank -%}
        <p class="avm-section-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="avm-display-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="avm-section-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="avm-blog-preview__grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.count -%}
          {%- liquid
            assign excerpt = article.excerpt | strip_html | strip
            if excerpt == blank
              assign excerpt = article.content | strip_html | truncatewords: 30
            endif
          -%}
          {%- render 'avm-article-card',
            url: article.url,
            title: article.title,
            category: article.tags.first,
            excerpt: excerpt,
            image: article.image,
            delay_index: forloop.index0
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- render 'avm-article-card',
          url: '/blogs/blog/instrument-quality-in-neurosurgery',
          title: 'Why instrument quality is non-negotiable in neurosurgery',
          category: 'Clinical Excellence',
          excerpt: 'In neurosurgery, the margin for error is zero. We explore why premium grade instruments are essential to patient outcomes and surgeon confidence.',
          asset: 'avm-blog-1.webp',
          delay_index: 0
        -%}
        {%- render 'avm-article-card',
          url: '/blogs/blog/surgeon-driven-innovation',
          title: 'How AVM develops instruments directly with surgeons',
          category: 'Innovation',
          excerpt: 'Our product development process starts in the operating theatre. Learn how practicing surgeons shape every instrument we bring to market.',
          asset: 'avm-blog-2.webp',
          delay_index: 1
        -%}
        {%- render 'avm-article-card',
          url: '/blogs/blog/care-and-maintenance',
          title: 'The complete guide to surgical instrument care and maintenance',
          category: 'Instrument Care',
          excerpt: 'Proper care extends instrument life and protects patients. A comprehensive guide to cleaning, sterilisation, and storage best practices.',
          asset: 'avm-blog-3.webp',
          delay_index: 2
        -%}
      {%- endif -%}
    </div>

    {%- if section.settings.view_all_label != blank -%}
      <div class="avm-blog-preview__more" data-avm-reveal style="--avm-reveal-delay: 0.2s;">
        <a href="{{ view_all_link }}" class="avm-pill">
          {{- section.settings.view_all_label | escape }}
          {% render 'avm-icon', icon: 'arrow-right', size: 16 -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "AVM blog preview",
  "tag": "section",
  "class": "avm-blog-preview-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "AVM Insights"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Knowledge Base"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Insights on surgical instrument care, innovation, and best practices."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Until this blog has articles, the three posts from the live site are shown."
    },
    {
      "type": "range",
      "id": "count",
      "label": "Articles to show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 3
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all articles"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Leave empty to link to the blog."
    }
  ],
  "presets": [
    {
      "name": "AVM blog preview"
    }
  ]
}
{% endschema %}
