{%- comment -%}
  AVM group of companies — mirrors GroupOfCompanies.tsx.
{%- endcomment -%}

{{ 'avm-group-companies.css' | asset_url | stylesheet_tag }}

<div class="avm avm-group">
  <div class="avm-group__inner">
    <div class="avm-section-header avm-group__header" data-avm-reveal>
      {%- if section.settings.label != blank -%}
        <p class="avm-section-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="avm-display-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="avm-group__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="avm-group__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign delay = forloop.index0 | modulo: 4 | times: 0.1
          assign logo_scale = block.settings.logo_scale | divided_by: 100.0
          assign logo_scale_hover = logo_scale | times: 1.05
          if block.settings.logo_scale != 100
            assign logo_scale_hover = logo_scale | plus: 0.08
          endif
        -%}
        <div class="avm-group__cell" data-avm-reveal style="--avm-reveal-delay: {{ delay }}s;" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" target="_blank" rel="noopener noreferrer" class="avm-group__card">
          {%- else -%}
            <div class="avm-group__card">
          {%- endif -%}
            <div class="avm-group__logo" style="--avm-logo-scale: {{ logo_scale }}; --avm-logo-scale-hover: {{ logo_scale_hover }};">
              {%- render 'avm-image',
                image: block.settings.logo,
                asset: block.settings.asset,
                alt: block.settings.name,
                class: 'avm-group__logo-img',
                sizes: '140px',
                widths: '140, 280, 420'
              -%}
            </div>
            <div class="avm-group__meta">
              <div class="avm-group__name">
                {{- block.settings.name | escape -}}
                {%- if block.settings.link != blank -%}
                  <span class="avm-group__external" aria-hidden="true">↗</span>
                {%- endif -%}
              </div>
              {%- if block.settings.subtitle != blank -%}
                <div class="avm-group__sub">{{ block.settings.subtitle | escape }}</div>
              {%- endif -%}
            </div>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AVM group companies",
  "tag": "section",
  "class": "avm-group-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Our group"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Part Of A Larger Family"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "AVM Healthcare is part of a group of companies united by a shared commitment to advancing surgical care."
    }
  ],
  "blocks": [
    {
      "type": "company",
      "name": "Company",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Bundled logo (fallback)",
          "info": "Theme asset used when no logo is picked. Leave as is."
        },
        {
          "type": "range",
          "id": "logo_scale",
          "label": "Logo scale",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100,
          "info": "The live site shows the ANI logo at 160%."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Company"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Website",
          "info": "Optional. Opens in a new tab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AVM group companies"
    }
  ]
}
{% endschema %}
