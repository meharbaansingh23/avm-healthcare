{%- comment -%}
  AVM contact — mirrors the Next.js /contact page (contact/page.tsx + ContactForm.tsx):
  intro, office cards, contact details row, divider, "Send Us A Message" form.

  The form POSTs to the "Form action URL" setting — NOT Shopify's /contact
  endpoint, which stays reserved for the quote system's hidden form.

  What the Next.js /api/contact route expects (JSON body):
    name, email, phone, organisation, message,
    company_website (honeypot, empty), form_started_at (ms timestamp)
  Responds { ok: true } on success, { ok: false, error } on failure.
  Phone / email / WhatsApp / social links come from Theme settings → AVM site.
{%- endcomment -%}

{{ 'avm-contact.css' | asset_url | stylesheet_tag }}
{{ 'avm-forms.css' | asset_url | stylesheet_tag }}
<script src="{{ 'avm-forms.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign whatsapp_url = 'https://wa.me/' | append: settings.avm_whatsapp_number
  assign phone_tel = settings.avm_phone_tel | default: settings.avm_phone | remove: ' '
-%}

<div class="avm avm-contact">
  <div class="avm-contact__inner">
    <div class="avm-contact__intro" data-avm-reveal>
      {%- if s.label != blank -%}
        <p class="avm-section-label">{{ s.label | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="avm-contact__heading">{{ s.heading | escape }}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="avm-contact__text">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="avm-contact__offices">
        {%- for block in section.blocks -%}
          <div class="avm-contact__office-cell" data-avm-reveal style="--avm-reveal-delay: {{ forloop.index0 | times: 0.1 }}s;" {{ block.shopify_attributes }}>
            <div class="avm-contact__office">
              <p class="avm-contact__office-name">{{ block.settings.name | escape }}</p>
              <p class="avm-contact__office-address">{{ block.settings.address | escape | newline_to_br }}</p>
              {%- if block.settings.maps_url != blank -%}
                <div class="avm-contact__office-action">
                  <a href="{{ block.settings.maps_url | escape }}" target="_blank" rel="noopener noreferrer" class="avm-pill avm-pill--sm">
                    View on Google Maps
                    {%- render 'avm-icon', icon: 'arrow-right', size: 14 -%}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="avm-contact__details" data-avm-reveal style="--avm-reveal-delay: 0.1s;">
      {%- if settings.avm_phone != blank -%}
        <div>
          <p class="avm-contact__detail-label">Phone</p>
          <a href="tel:{{ phone_tel }}" class="avm-contact__link">{{ settings.avm_phone | escape }}</a>
        </div>
      {%- endif -%}
      {%- if settings.avm_email != blank -%}
        <div>
          <p class="avm-contact__detail-label">Email</p>
          <a href="mailto:{{ settings.avm_email }}" class="avm-contact__link">{{ settings.avm_email | escape }}</a>
        </div>
      {%- endif -%}
      {%- if settings.avm_whatsapp_number != blank -%}
        <div>
          <p class="avm-contact__detail-label">WhatsApp</p>
          <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="avm-contact__link avm-contact__link--icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zm0 18.15h-.01c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.15 8.15 0 0 1-1.25-4.38c0-4.51 3.67-8.18 8.19-8.18 2.19 0 4.24.85 5.79 2.41a8.13 8.13 0 0 1 2.4 5.78c0 4.51-3.68 8.23-8.14 8.23zm4.48-6.13c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.57.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/></svg>
            {{- s.whatsapp_label | escape -}}
          </a>
        </div>
      {%- endif -%}
      {%- if s.hours != blank -%}
        <div>
          <p class="avm-contact__detail-label">Working hours</p>
          <p class="avm-contact__hours">{{ s.hours | escape }}</p>
        </div>
      {%- endif -%}
      {%- if settings.avm_linkedin_url != blank or settings.avm_facebook_url != blank -%}
        <div>
          <p class="avm-contact__detail-label">Follow us</p>
          <div class="avm-contact__social">
            {%- if settings.avm_linkedin_url != blank -%}
              <a href="{{ settings.avm_linkedin_url | escape }}" target="_blank" rel="noopener noreferrer" class="avm-contact__link avm-contact__link--icon avm-contact__link--strong">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            {%- endif -%}
            {%- if settings.avm_facebook_url != blank -%}
              <a href="{{ settings.avm_facebook_url | escape }}" target="_blank" rel="noopener noreferrer" class="avm-contact__link avm-contact__link--icon avm-contact__link--strong">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.022 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.878h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.918 8.437-9.94z"/></svg>
                Facebook
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <span class="avm-contact__divider" aria-hidden="true"></span>

    <div class="avm-contact__form" data-avm-reveal style="--avm-reveal-delay: 0.1s;">
      <avm-form-handler
        data-action="{{ s.form_action | escape }}"
        data-encoding="json"
        data-ok-key="ok"
        data-success="inline"
        data-server-errors
        data-error-message="Something went wrong. Please try again."
      >
        <form class="avm-form" method="post" aria-busy="false">
          {%- render 'avm-form-spam-guard', prefix: 'ct' -%}
          {%- if s.form_heading != blank -%}
            <h2 class="avm-form__title">{{ s.form_heading | escape }}</h2>
          {%- endif -%}
          {%- render 'avm-form-notice', action: s.form_action -%}

          <div class="avm-form-alert avm-form-alert--success" role="status" aria-live="polite" data-avm-form-success hidden>
            {{- s.success_message | escape -}}
          </div>
          <div class="avm-form-alert avm-form-alert--error" role="alert" data-avm-form-error hidden></div>

          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'ct-name', name: 'name', label: 'Name', is_required: true -%}
            {%- render 'avm-form-field', id: 'ct-email', name: 'email', label: 'Email', type: 'email', is_required: true -%}
          </div>
          {%- render 'avm-form-field', id: 'ct-phone', name: 'phone', label: 'Phone', type: 'tel' -%}
          {%- render 'avm-form-field', id: 'ct-organisation', name: 'organisation', label: 'Organisation' -%}
          {%- render 'avm-form-field', id: 'ct-message', name: 'message', label: 'Message', type: 'textarea', rows: 5, is_required: true -%}

          <button type="submit" class="avm-form-submit">Send message</button>
        </form>
      </avm-form-handler>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AVM contact",
  "tag": "section",
  "class": "avm-contact-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Contact us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get In Touch" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our team is based in New Delhi and is available Monday to Saturday, 9:30am to 6:30pm IST."
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "paragraph",
      "content": "Phone, email, WhatsApp and social links come from Theme settings → AVM site."
    },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp link text", "default": "Message us" },
    { "type": "text", "id": "hours", "label": "Working hours", "default": "Monday – Saturday · 9:30 am – 6:30 pm IST" },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_action",
      "label": "Form action URL",
      "info": "Endpoint that receives the message as JSON (name, email, phone, organisation, message, company_website, form_started_at) and replies { ok: true }. Must allow cross-origin requests from this store. Never use /contact here."
    },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send Us A Message" },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We’ll be in touch within one business day."
    }
  ],
  "blocks": [
    {
      "type": "office",
      "name": "Office",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Office" },
        { "type": "textarea", "id": "address", "label": "Address" },
        { "type": "text", "id": "maps_url", "label": "Google Maps link", "info": "Optional." }
      ]
    }
  ],
  "presets": [{ "name": "AVM contact" }]
}
{% endschema %}
