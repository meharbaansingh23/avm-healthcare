{%- comment -%}
  AVM hero — mirrors the Next.js homepage hero (HomeContent.tsx section 1 +
  HeroSlideshow.tsx) and the quote strip directly below it (section 2).
  Slides with no image picked fall back to the bundled assets/avm-hero-N.webp.
{%- endcomment -%}

{{ 'avm-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'avm-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign button_link = section.settings.button_link | default: '/pages/request-catalogue'
-%}

<div class="avm">
  <section class="avm-hero">
    <avm-hero-slideshow
      class="avm-hero__slideshow"
      role="region"
      aria-roledescription="carousel"
      aria-label="Hero image slideshow"
    >
      {%- for i in (1..3) -%}
        {%- liquid
          assign image_key = 'slide_' | append: i | append: '_image'
          assign alt_key = 'slide_' | append: i | append: '_alt'
          assign image = section.settings[image_key]
          assign alt = section.settings[alt_key] | default: image.alt
          if forloop.first
            assign loading = 'eager'
          else
            assign loading = 'lazy'
          endif
        -%}
        <div
          class="avm-hero__slide{% if forloop.first %} is-active{% endif %}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        >
          {%- if image != blank -%}
            {%- if forloop.first -%}
              {{
                image
                | image_url: width: 3840
                | image_tag:
                  widths: '640, 750, 828, 1080, 1200, 1920, 2048, 3840',
                  sizes: '100vw',
                  width: image.width,
                  height: image.height,
                  loading: 'eager',
                  fetchpriority: 'high',
                  preload: true,
                  alt: alt,
                  class: 'avm-hero__img'
              }}
            {%- else -%}
              {{
                image
                | image_url: width: 3840
                | image_tag:
                  widths: '640, 750, 828, 1080, 1200, 1920, 2048, 3840',
                  sizes: '100vw',
                  width: image.width,
                  height: image.height,
                  loading: 'lazy',
                  alt: alt,
                  class: 'avm-hero__img'
              }}
            {%- endif -%}
          {%- else -%}
            {%- liquid
              case i
                when 1
                  assign fallback_width = 3011
                  assign fallback_height = 2545
                when 2
                  assign fallback_width = 1924
                  assign fallback_height = 1083
                else
                  assign fallback_width = 1504
                  assign fallback_height = 1004
              endcase
              assign fallback_src = 'avm-hero-' | append: i | append: '.webp'
            -%}
            <img
              src="{{ fallback_src | asset_url }}"
              alt="{{ alt | escape }}"
              width="{{ fallback_width }}"
              height="{{ fallback_height }}"
              loading="{{ loading }}"
              {% if forloop.first %}
                fetchpriority="high"
              {% endif %}
              class="avm-hero__img"
            >
          {%- endif -%}
        </div>
      {%- endfor -%}

      <span class="avm-hero__gradient" aria-hidden="true"></span>
      <span class="avm-hero__vignette" aria-hidden="true"></span>

      <div class="avm-hero__dots">
        {%- for i in (1..3) -%}
          <button
            type="button"
            class="avm-hero__dot"
            aria-label="Go to slide {{ i }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    </avm-hero-slideshow>

    <div class="avm-hero__inner">
      <div class="avm-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="avm-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="avm-hero__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <p class="avm-hero__intro">{{ section.settings.intro | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="avm-hero__actions">
            <a href="{{ button_link }}" class="avm-hero__cta">
              {{- section.settings.button_label | escape -}}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.quote != blank -%}
    <section class="avm-quote">
      <div class="avm-quote__inner">
        <span class="avm-quote__rule" aria-hidden="true"></span>
        <avm-reveal>
          <blockquote class="avm-quote__text">&ldquo;{{ section.settings.quote | escape }}&rdquo;</blockquote>
        </avm-reveal>
        {%- if section.settings.quote_attribution != blank -%}
          <p class="avm-quote__attribution">&mdash; {{ section.settings.quote_attribution | escape }}</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AVM hero",
  "tag": "div",
  "class": "avm-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "paragraph",
      "content": "Three background images crossfade every 6 seconds. An empty slot uses the bundled image from the live site."
    },
    {
      "type": "image_picker",
      "id": "slide_1_image",
      "label": "Slide 1 image",
      "info": "Loads first (high priority). Use a landscape image at least 1920px wide."
    },
    {
      "type": "text",
      "id": "slide_1_alt",
      "label": "Slide 1 alt text",
      "default": "Surgical instruments arranged on a blue surgical drape with warm bokeh"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image",
      "label": "Slide 2 image"
    },
    {
      "type": "text",
      "id": "slide_2_alt",
      "label": "Slide 2 alt text",
      "default": "Precision surgical instruments laid out on a green drape in an operating room"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image",
      "label": "Slide 3 image"
    },
    {
      "type": "text",
      "id": "slide_3_alt",
      "label": "Slide 3 alt text",
      "default": "A gloved hand placing a surgical instrument onto a tray"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Surgical Instruments · Made in India · Since 1996"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Precision Instruments For Modern Surgical Care"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "AVM Healthcare Products supplies advanced Surgical instruments to premier hospitals across India — from Neurosurgery to Cardiovascular care."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request catalogue"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to /pages/request-catalogue."
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "info": "Curly quotes are added automatically. Leave empty to hide the quote strip.",
      "default": "Our motto is to provide world-class instruments for the benefit of mankind."
    },
    {
      "type": "text",
      "id": "quote_attribution",
      "label": "Attribution",
      "info": "An em dash is added in front automatically.",
      "default": "Anil Chaba · Director"
    }
  ],
  "presets": [
    {
      "name": "AVM hero"
    }
  ]
}
{% endschema %}
