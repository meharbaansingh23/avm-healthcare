{%- comment -%}
  AVM footer — mirrors the Next.js Footer.tsx.
  Link columns come from a Shopify menu: each top-level item is a column
  heading, its sub-items are the links. Until that menu exists (or if it
  has no sub-items) the live site's columns are shown.
  Contact details and social URLs come from Theme settings → AVM site.
{%- endcomment -%}

{{ 'avm-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign has_menu_columns = false
  for link in menu.links
    if link.links.size > 0
      assign has_menu_columns = true
      break
    endif
  endfor
  assign whatsapp_url = 'https://wa.me/' | append: settings.avm_whatsapp_number
-%}

<footer class="avm avm-footer">
  <div class="avm-footer__inner">
    <div class="avm-footer__top">
      <div>
        <a href="{{ routes.root_url }}" class="avm-footer__logo">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag:
                class: 'avm-footer__logo-img',
                widths: '130, 260, 400',
                sizes: '130px',
                width: section.settings.logo.width,
                height: section.settings.logo.height,
                loading: 'lazy',
                alt: shop.name
            }}
          {%- else -%}
            <img
              src="{{ 'avm-logo-dark.png' | asset_url }}"
              alt="AVM Healthcare Products"
              width="1015"
              height="251"
              loading="lazy"
              class="avm-footer__logo-img"
            >
          {%- endif -%}
        </a>

        <div class="avm-footer__socials">
          {%- if settings.avm_linkedin_url != blank -%}
            <a href="{{ settings.avm_linkedin_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="avm-footer__social">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.avm_facebook_url != blank -%}
            <a href="{{ settings.avm_facebook_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="avm-footer__social">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.022 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.878h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.918 8.437-9.94z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.avm_instagram_url != blank -%}
            <a href="{{ settings.avm_instagram_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="avm-footer__social">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.avm_whatsapp_number != blank -%}
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="avm-footer__social">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zm0 18.15h-.01c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.15 8.15 0 0 1-1.25-4.38c0-4.51 3.67-8.18 8.19-8.18 2.19 0 4.24.85 5.79 2.41a8.13 8.13 0 0 1 2.4 5.78c0 4.51-3.68 8.23-8.14 8.23zm4.48-6.13c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.57.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="avm-footer__columns">
        {%- if has_menu_columns -%}
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <div>
                <h3 class="avm-footer__heading">{{ link.title | escape }}</h3>
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" class="avm-footer__link">{{ child.title | escape }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div>
            <h3 class="avm-footer__heading">Company</h3>
            <a href="{{ routes.root_url }}" class="avm-footer__link">Home</a>
            <a href="/pages/about" class="avm-footer__link">About Us</a>
            <a href="/pages/contact" class="avm-footer__link">Contact</a>
          </div>
          <div>
            <h3 class="avm-footer__heading">Services</h3>
            <a href="/pages/request-catalogue" class="avm-footer__link">Request Catalogue</a>
            <a href="/pages/innovation" class="avm-footer__link">Innovation</a>
          </div>
          <div>
            <h3 class="avm-footer__heading">Connect</h3>
            <a href="/pages/careers" class="avm-footer__link">Careers</a>
            <a href="/blogs/blog" class="avm-footer__link">Blog</a>
          </div>
        {%- endif -%}

        <div>
          <h3 class="avm-footer__heading">Contact</h3>
          {%- if settings.avm_address != blank -%}
            <p class="avm-footer__address">{{ settings.avm_address | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if settings.avm_phone != blank -%}
            <a href="tel:{{ settings.avm_phone_tel | default: settings.avm_phone | remove: ' ' }}" class="avm-footer__link">
              {{- settings.avm_phone | escape -}}
            </a>
          {%- endif -%}
          {%- if settings.avm_email != blank -%}
            <a href="mailto:{{ settings.avm_email }}" class="avm-footer__link">{{ settings.avm_email | escape }}</a>
          {%- endif -%}
          {%- if settings.avm_whatsapp_number != blank -%}
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="avm-footer__link">WhatsApp Us</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="avm-footer__bottom">
      <p class="avm-footer__legal">
        &copy; {{ 'now' | date: '%Y' }}
        {{ section.settings.copyright | escape }}
      </p>
      <p class="avm-footer__legal">{{ section.settings.rights | escape }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "AVM footer",
  "tag": "div",
  "class": "avm-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Contact details and social links are in Theme settings → AVM site."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the live site's logo."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer",
      "info": "Each top-level item is a column heading; its sub-items are the links. Until the menu has sub-items, the live site's columns are shown."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "info": "Shown after © and the current year.",
      "default": "AVM Healthcare Products Pvt. Ltd. · New Delhi, India"
    },
    {
      "type": "text",
      "id": "rights",
      "label": "Right-hand text",
      "default": "All rights reserved"
    }
  ]
}
{% endschema %}
