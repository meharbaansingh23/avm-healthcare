{%- comment -%}
  AVM innovation form — mirrors the #proposal section of innovation/page.tsx + InnovationForm.tsx.

  Shopify's native contact form ({% form 'contact' %}, id AvmInnovationForm), submitted
  natively. Fields: contact[Form] = "Innovation proposal", contact[Name],
  contact[Organisation], contact[email], contact[Phone], contact[Nature of proposal],
  contact[body] (Describe your idea).
  After sending, the success state replaces the fields (live InnovationForm.tsx).
{%- endcomment -%}

{{ 'avm-forms.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<div class="avm avm-form-section avm-form-section__anchor" id="{{ s.anchor | default: 'proposal' | handleize }}">
  <div class="avm-form-section__inner">
    <div class="avm-form-section__header" data-avm-reveal>
      {%- if s.heading != blank -%}
        <h2 class="avm-form-section__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="avm-form-section__text">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>

    <div data-avm-reveal style="--avm-reveal-delay: 0.1s;">
      {%- form 'contact', id: 'AvmInnovationForm', class: 'avm-native-form' -%}
        <input type="hidden" name="contact[Form]" value="Innovation proposal">
        <div class="avm-form" data-avm-form-fields {% if form.posted_successfully? %}hidden{% endif %}>
          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'i-name', name: 'contact[Name]', label: 'Name', is_required: true -%}
            {%- render 'avm-form-field', id: 'i-org', name: 'contact[Organisation]', label: 'Organisation' -%}
          </div>
          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'i-email', name: 'contact[email]', label: 'Email', type: 'email', is_required: true, value: form.email -%}
            {%- render 'avm-form-field', id: 'i-phone', name: 'contact[Phone]', label: 'Phone', type: 'tel' -%}
          </div>
          {%- render 'avm-form-field',
            id: 'i-type',
            name: 'contact[Nature of proposal]',
            label: 'Nature of proposal',
            type: 'select',
            is_required: true,
            options: s.proposal_types,
            select_placeholder: 'Select a type'
          -%}
          {%- render 'avm-form-field',
            id: 'i-desc',
            name: 'contact[body]',
            label: 'Describe your idea',
            type: 'textarea',
            rows: 6,
            is_required: true,
            value: form.body,
            placeholder: "Give us an overview of what you have in mind — the problem you're solving, the product concept, and how you see AVM being involved."
          -%}

          {%- if form.errors -%}
            <div class="avm-form-alert avm-form-alert--error" role="alert" data-avm-form-state>
              {{- s.error_message | escape -}}
            </div>
          {%- endif -%}

          <button type="submit" class="avm-form-submit">Submit proposal</button>
        </div>
        {%- if form.posted_successfully? -%}
          {%- render 'avm-form-success', message: s.success_message, server_state: true -%}
        {%- endif -%}
      {%- endform -%}
      {%- render 'avm-native-form-state', form_id: 'AvmInnovationForm' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AVM innovation form",
  "tag": "section",
  "class": "avm-innovation-form-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "The hero button links here, e.g. #proposal.", "default": "proposal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Submit A Proposal" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us about your idea — the problem you’re solving, the product concept, and how you see AVM being involved."
    },
    {
      "type": "textarea",
      "id": "proposal_types",
      "label": "Proposal types",
      "info": "One per line.",
      "default": "New product concept\nManufacturing partnership\nResearch collaboration\nTechnology licensing\nOther"
    },
    {
      "type": "header",
      "content": "Submission"
    },
    {
      "type": "paragraph",
      "content": "Sent through Shopify's contact form to the store's sender email, labelled \"Innovation proposal\"."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "We've received your proposal. We'll be in touch soon."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Something went wrong. Please try again or email us directly at sales@avmhealthcare.com."
    }
  ],
  "presets": [{ "name": "AVM innovation form" }]
}
{% endschema %}
