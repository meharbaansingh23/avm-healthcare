{%- comment -%}
  AVM innovation form — mirrors the #proposal section of innovation/page.tsx + InnovationForm.tsx.

  What the Next.js /api/innovation route expects (JSON body):
    name*, organisation, email*, phone, proposalType*, description*,
    company_website (honeypot, empty), form_started_at (ms timestamp)
  Responds { success: true } on success, { success: false, error } on failure.
{%- endcomment -%}

{{ 'avm-forms.css' | asset_url | stylesheet_tag }}
<script src="{{ 'avm-forms.js' | asset_url }}" defer="defer"></script>

{%- assign s = section.settings -%}

<div class="avm avm-form-section avm-form-section__anchor" id="{{ s.anchor | default: 'proposal' | handleize }}">
  <div class="avm-form-section__inner">
    <div class="avm-form-section__header" data-avm-reveal>
      {%- if s.heading != blank -%}
        <h2 class="avm-form-section__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="avm-form-section__text">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>

    <div data-avm-reveal style="--avm-reveal-delay: 0.1s;">
      <avm-form-handler
        data-action="{{ s.form_action | escape }}"
        data-encoding="json"
        data-ok-key="success"
        data-success="replace"
        data-error-message="{{ s.error_message | escape }}"
      >
        <form class="avm-form" method="post" aria-busy="false">
          {%- render 'avm-form-spam-guard', prefix: 'i' -%}
          {%- render 'avm-form-notice', action: s.form_action -%}

          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'i-name', name: 'name', label: 'Name', is_required: true -%}
            {%- render 'avm-form-field', id: 'i-org', name: 'organisation', label: 'Organisation' -%}
          </div>
          <div class="avm-form__row">
            {%- render 'avm-form-field', id: 'i-email', name: 'email', label: 'Email', type: 'email', is_required: true -%}
            {%- render 'avm-form-field', id: 'i-phone', name: 'phone', label: 'Phone', type: 'tel' -%}
          </div>
          {%- render 'avm-form-field',
            id: 'i-type',
            name: 'proposalType',
            label: 'Nature of proposal',
            type: 'select',
            is_required: true,
            options: s.proposal_types,
            select_placeholder: 'Select a type'
          -%}
          {%- render 'avm-form-field',
            id: 'i-desc',
            name: 'description',
            label: 'Describe your idea',
            type: 'textarea',
            rows: 6,
            is_required: true,
            placeholder: "Give us an overview of what you have in mind — the problem you're solving, the product concept, and how you see AVM being involved."
          -%}

          <div class="avm-form-alert avm-form-alert--error" role="alert" data-avm-form-error hidden></div>

          <button type="submit" class="avm-form-submit">Submit proposal</button>
        </form>
        {%- render 'avm-form-success', message: s.success_message -%}
      </avm-form-handler>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AVM innovation form",
  "tag": "section",
  "class": "avm-innovation-form-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "The hero button links here, e.g. #proposal.", "default": "proposal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Submit A Proposal" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us about your idea — the problem you’re solving, the product concept, and how you see AVM being involved."
    },
    {
      "type": "textarea",
      "id": "proposal_types",
      "label": "Proposal types",
      "info": "One per line.",
      "default": "New product concept\nManufacturing partnership\nResearch collaboration\nTechnology licensing\nOther"
    },
    {
      "type": "header",
      "content": "Submission"
    },
    {
      "type": "text",
      "id": "form_action",
      "label": "Form action URL",
      "info": "Endpoint for the innovation form (JSON, replies { success: true }). Field list: see the section file."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "We've received your proposal. We'll be in touch soon."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Something went wrong. Please try again or email us directly at sales@avmhealthcare.com."
    }
  ],
  "presets": [{ "name": "AVM innovation form" }]
}
{% endschema %}
