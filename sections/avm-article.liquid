{%- comment -%}
  AVM blog article — mirrors blog/[slug]/page.tsx: back link, centered title,
  date · read time, cover image, article body, catalogue CTA box, plus the
  BlogPosting and BreadcrumbList structured data.
  Read time ≈ words ÷ 200, as on the live site.
{%- endcomment -%}

{{ 'avm-article.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_minutes = word_count | times: 1.0 | divided_by: 200 | round | at_least: 1
  assign published_label = article.published_at | date: '%B %Y'
  assign cta_link = section.settings.cta_link | default: '/pages/request-catalogue'
  assign article_description = article.excerpt | strip_html | strip
  if article_description == blank
    assign article_description = article.content | strip_html | strip | truncatewords: 40
  endif
-%}

<article class="avm avm-article">
  <div class="avm-article__inner">
    <a href="{{ blog.url }}" class="avm-article__back">{{ section.settings.back_label | escape }}</a>

    <div class="avm-article__header">
      <h1 class="avm-display-heading avm-article__title">{{ article.title | escape }}</h1>
      <div class="avm-article__meta">
        <span>{{ published_label }}</span>
        <span aria-hidden="true">·</span>
        <span>{{ read_minutes }} min read</span>
      </div>
    </div>

    {%- if article.image -%}
      {%- assign cover_alt = article.image.alt | default: article.title -%}
      <div class="avm-article__cover">
        {{
          article.image
          | image_url: width: 1536
          | image_tag:
            widths: '600, 900, 1200, 1536',
            sizes: '(min-width: 768px) 768px, 100vw',
            width: article.image.width,
            height: article.image.height,
            loading: 'eager',
            fetchpriority: 'high',
            alt: cover_alt,
            class: 'avm-article__cover-img'
        }}
      </div>
    {%- endif -%}

    <div class="avm-article__body">
      {{ article.content }}
    </div>

    {%- if section.settings.cta_heading != blank -%}
      <div class="avm-article__cta">
        <h3 class="avm-article__cta-heading">{{ section.settings.cta_heading | escape }}</h3>
        {%- if section.settings.cta_text != blank -%}
          <p class="avm-article__cta-text">{{ section.settings.cta_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ cta_link }}" class="avm-article__cta-button">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>

{%- liquid
  assign base_url = request.origin
  assign article_url = base_url | append: article.url
  assign blog_url = base_url | append: blog.url
  if article.image
    assign schema_image = article.image | image_url: width: 1200 | prepend: 'https:'
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ article_url | append: '#article' | json }},
    "headline": {{ article.title | json }},
    "description": {{ article_description | json }},
    "url": {{ article_url | json }},
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ article_url | json }} },
    {%- if article.image %}
    "image": {{ schema_image | json }},
    {%- endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@id": {{ base_url | append: '/#organization' | json }} },
    "publisher": { "@id": {{ base_url | append: '/#organization' | json }} },
    "inLanguage": "en-IN",
    "isAccessibleForFree": true
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ base_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog_url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ article_url | json }} }
    ]
  }
</script>

{% schema %}
{
  "name": "AVM article",
  "tag": "section",
  "class": "avm-article-section",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back link text", "default": "← Back to insights" },
    {
      "type": "header",
      "content": "Catalogue box"
    },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Interested In Our Surgical Instruments?" },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Text",
      "default": "Request our detailed catalogue — over 10,000 instruments across six specialties."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Request full catalogue →" },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave empty to link to /pages/request-catalogue."
    }
  ]
}
{% endschema %}
