{%- comment -%}
  AVM video — mirrors HomeContent.tsx section 4.7 ("Inside AVM").
{%- endcomment -%}

{{ 'avm-video.css' | asset_url | stylesheet_tag }}

<div class="avm avm-video">
  <div class="avm-section-header" data-avm-reveal>
    {%- if section.settings.label != blank -%}
      <p class="avm-section-label avm-section-label--accent">{{ section.settings.label | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="avm-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  {%- if section.settings.video != blank -%}
    {%- liquid
      if section.settings.video.type == 'youtube'
        assign embed_url = 'https://www.youtube.com/embed/' | append: section.settings.video.id
      else
        assign embed_url = 'https://player.vimeo.com/video/' | append: section.settings.video.id
      endif
    -%}
    <div class="avm-video__wrap" data-avm-reveal style="--avm-reveal-delay: 0.1s;">
      <div class="avm-video__frame">
        <iframe
          src="{{ embed_url }}"
          title="{{ section.settings.video_title | escape }}"
          width="100%"
          height="100%"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AVM video",
  "tag": "section",
  "class": "avm-video-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Inside AVM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See Our Story In Motion"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "Video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title (for screen readers)",
      "default": "AVM Healthcare Products — Our Story"
    }
  ],
  "presets": [
    {
      "name": "AVM video"
    }
  ]
}
{% endschema %}
