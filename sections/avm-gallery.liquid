{%- comment -%}
  AVM gallery — mirrors HomeContent.tsx section 4.5 (ImageCarousel.tsx).
  Cards keep their natural ratio at a fixed height and loop infinitely.
{%- endcomment -%}

{{ 'avm-gallery.css' | asset_url | stylesheet_tag }}

{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- liquid
      if block.settings.image != blank
        assign ratio = block.settings.image.aspect_ratio
      else
        capture size
          render 'avm-asset-size', asset: block.settings.asset
        endcapture
        assign size = size | strip | split: ' '
        assign ratio = size[0] | times: 1.0 | divided_by: size[1]
      endif
    -%}
    <div class="avm-gallery__card" style="aspect-ratio: {{ ratio }};" {{ block.shopify_attributes }}>
      {%- render 'avm-image',
        image: block.settings.image,
        asset: block.settings.asset,
        alt: block.settings.alt,
        class: 'avm-gallery__img',
        sizes: '(max-width: 768px) 70vw, 40vw',
        widths: '400, 600, 800, 1000, 1200, 1600'
      -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div class="avm avm-gallery">
  <div class="avm-gallery__header avm-section-header" data-avm-reveal>
    {%- if section.settings.label != blank -%}
      <p class="avm-section-label avm-section-label--accent">{{ section.settings.label | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="avm-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div
      class="avm-gallery__carousel"
      style="--avm-carousel-duration: {{ section.settings.duration }}s;"
      role="region"
      aria-label="Image carousel"
    >
      <div class="avm-gallery__track">
        <div class="avm-gallery__group">{{ cards }}</div>
        <div class="avm-gallery__group" aria-hidden="true" inert>{{ cards }}</div>
      </div>
      <span class="avm-gallery__fade avm-gallery__fade--left" aria-hidden="true"></span>
      <span class="avm-gallery__fade avm-gallery__fade--right" aria-hidden="true"></span>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AVM gallery",
  "tag": "section",
  "class": "avm-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Our Craft"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted With Precision"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Seconds per loop",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Bundled image (fallback)",
          "info": "Theme asset used when no image is picked. Leave as is."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AVM gallery"
    }
  ]
}
{% endschema %}
