{%- comment -%}
  AVM CTA card — mirrors the About page closing CTA (white card on off-white).
{%- endcomment -%}

{{ 'avm-about.css' | asset_url | stylesheet_tag }}

{%- assign button_link = section.settings.button_link | default: '/pages/request-catalogue' -%}

<div class="avm avm-cta-card-section-inner">
  <div class="avm-cta-card" data-avm-reveal>
    {%- if section.settings.heading != blank -%}
      <h3 class="avm-cta-card__heading">{{ section.settings.heading | escape }}</h3>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="avm-cta-card__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ button_link }}" class="avm-cta-card__button">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "AVM CTA card",
  "tag": "section",
  "class": "avm-cta-card-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get Our Detailed Product Catalogue" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Over 10,000 Surgical Products across multiple specialties — delivered to your inbox within one business day."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request full catalogue →" },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to /pages/request-catalogue."
    }
  ],
  "presets": [{ "name": "AVM CTA card" }]
}
{% endschema %}
